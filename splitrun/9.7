#%Module

variable thisLocation [file normalize [info script]]
# Where the images are: $STACKTAINER_IMAGES if set, else where VISA keeps them.
proc getResourcePath {resource} {
  set dir /apps/containers/bin/stacktainer
  if { [info exists ::env(STACKTAINER_IMAGES)] } {
    set dir $::env(STACKTAINER_IMAGES)
  }
  return [file join $dir $resource]
}
# An extracted sandbox, {name}_{ver}/, is preferred over {name}_{ver}.sif. A SIF
# is mounted through FUSE, which some hosts (containers, mostly) do not have;
# `unsquashfs -d {name}_{ver} {name}_{ver}.sif` makes a sandbox that needs none.
proc getImagePath {} {
  variable thisLocation
  set ver [file tail $thisLocation]
  set name [file tail [file dirname $thisLocation]]
  set sandbox [getResourcePath "${name}_${ver}"]
  if { [file isdirectory $sandbox] } {
    return $sandbox
  }
  return [getResourcePath "${name}_${ver}.sif"]
}
# the absolute path to the image file, to allow alias-use from anywhere
set tainer [getImagePath]

# restage keeps its database under $XDG_CACHE_HOME unless RESTAGE_CACHE says otherwise,
# and this image sets XDG_CACHE_HOME to its read-only, baked mccode-antlr cache. So
# restage is pointed at ~/.cache/restage -- where it wrote under earlier images, which
# left XDG_CACHE_HOME unset -- unless RESTAGE_CACHE is already set.
proc restageCache {} {
  if { [info exists ::env(RESTAGE_CACHE)] } {
    return $::env(RESTAGE_CACHE)
  }
  return [file join $::env(HOME) .cache restage]
}

# Optional: a writable copy of the mccode-antlr cache, for adding component registries
# or keeping parsed components between runs. The read-only one is enough to translate.
# Set SPLITRUN_CACHE_HOME to have one made (571 MB, once; later loads only check the
# stamp, and a new image re-seeds) and used.
if { [info exists ::env(SPLITRUN_CACHE_HOME)] && [module-info mode load] } {
  if { [catch {exec apptainer exec --home $::env(HOME) $tainer splitrun-cache-seed -q $::env(SPLITRUN_CACHE_HOME)} err] } {
    puts stderr "stacktainer/splitrun: could not seed $::env(SPLITRUN_CACHE_HOME): $err"
  }
}

proc app_flags {} {
  set flag {--env RESTAGE_FIXED=${RESTAGE_FIXED}}
  if { [info exists ::env(RESTAGE_FIXED)] } {
    set flag [format {--env RESTAGE_FIXED=%s} $::env(RESTAGE_FIXED)]
  }
  if { [info exists ::env(BIND)] } {
    # Only what exists here: apptainer refuses to start if a bind source is
    # missing, and the default list names VISA's filesystems.
    set present {}
    foreach spec [split $::env(BIND) ,] {
      if { $spec ne {} && [file exists [lindex [split $spec :] 0]] } {
        lappend present $spec
      }
    }
    if { [llength $present] } {
      set flag [format {%s --bind %s} $flag [join $present ,]]
    }
  }
  set flag [format {%s --env RESTAGE_CACHE=%s} $flag [restageCache]]
  if { [info exists ::env(SPLITRUN_CACHE_HOME)] } {
    set flag [format {%s --env XDG_CACHE_HOME=%s} $flag $::env(SPLITRUN_CACHE_HOME)]
  }
  # Say which home to mount rather than let apptainer work it out: inside a
  # user-namespaced container it can resolve the invoking user's home as /root,
  # mount that, and leave $HOME pointing at a directory that does not exist.
  if { [info exists ::env(HOME)] } {
    set flag [format {%s --home %s} $flag $::env(HOME)]
  }
  return $flag
}

# only expose a subset of the binaries/python-entrypoints

# Anything exposed as a function can be used by subshells,
# e.g., a bash script executed from a module-loaded shell
# will be able to access these.
# BUT 'system' call methods, which launch a new shell
# (Linux system(3) called from, e.g., C, 
#  Python's subprocess.run({str}, shell=True), etc.) 
# Will NOT be able to use these programs.
set expose_via_func [list\
  python \
  mcstas-antlr \
  mccode-antlr \
  mcrun-antlr \
  mp-splitrun \
  mp-nexus-splitrun \
  mp-nexus-services \
  mp-nexus-collect-replay \
  mp-replay \
  mp-nexus-replay \
  mp-register-topics \
  mp-writer-list \
  mp-writer-kill \
  mp-writer-killall \
  mccode-to-kafka \
  splitrun \
  mcpltool \
  mcpl-config \
  ncrystal-mcstasunion \
  ncrystal-config \
  readout-config \
  readout-replay \
]
# Any program exposed via an alias, however,
# can not be called from a subshell but CAN
# be called via the system call method?!
set expose_via_alias [list mp-epics-update]


# Define functions so that we can employ loops
proc make_alias {to} {
  global tainer
  set-alias $to [format {apptainer exec %s %s %s} [app_flags] $tainer $to]
}
# function definitions are shelltype dependent
switch -- [module-info shelltype] {
{sh} {
  set appfunc [format {apptainer run %s "$@"} $tainer]
  proc make_func {to} {
    global tainer
    set-function $to [format {apptainer exec %s %s %s "$@"} [app_flags] $tainer $to]
  }
  }
}

# Loop over the to-be-exposed function names and call the appropriate proc
foreach name $expose_via_alias {
  make_alias $name
}

# define functions if current shell supports shell function and we
# defined the process to call shell-function
if {[info exists appfunc]} {
  # A utility function to run anything in the image
  set-function stackrun $appfunc
  # loop over the names to expose as functions
  foreach name $expose_via_func {
    make_func $name
  }
}

